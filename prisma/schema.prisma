generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  slug         String    @id
  name         String
  translations String    @default("{}")
  products     Product[]
}

model Product {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String       @default("")
  translations String       @default("{}")
  price        Decimal      @db.Decimal(10, 2)
  comparePrice Decimal?     @db.Decimal(10, 2)
  image        String
  categorySlug String
  category     Category     @relation(fields: [categorySlug], references: [slug], onUpdate: Cascade, onDelete: Restrict)
  stock        Int          @default(0)
  published    Boolean      @default(true)
  variants     Variant[]
  favorites    FavoriteProduct[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([published, categorySlug])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  size      String?
  stock     Int     @default(0)
  price     Decimal? @db.Decimal(10, 2)

  @@unique([productId, color, size])
}

model FavoriteProduct {
  id             String       @id @default(cuid())
  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([customerUserId, productId])
  @@index([customerUserId, createdAt])
}

model StoreOrder {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerUserId String?
  customerUser CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  status      String      @default("NEW")
  customerName String
  phone       String
  city        String
  address     String
  notes       String?
  payment     String
  deliveryAreaName String?
  paymentReceiptUrl String?
  bestRouteState String @default("NOT_SENT")
  bestRouteOrderId String?
  bestRouteError String?
  bestRouteUpdatedAt DateTime?
  subtotal    Decimal     @db.Decimal(10, 2)
  shipping    Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  items       OrderItem[]

  @@index([createdAt])
  @@index([status])
  @@index([customerUserId, createdAt])
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  image       String
  option      String?
  qty         Int
  unitPrice   Decimal    @db.Decimal(10, 2)
}

model StoreSettings {
  id                Int     @id @default(1)
  storeName         String  @default("RAWNQ Home & Living")
  phone             String  @default("")
  whatsapp          String  @default("")
  instagram         String  @default("")
  shippingFee       Decimal @default(20) @db.Decimal(10, 2)
  freeShippingFrom  Decimal? @db.Decimal(10, 2)
  cod               Boolean @default(true)
  bank              Boolean @default(false)
  bankDetails       String  @default("")
  bankAccountName   String  @default("")
  bankIban          String  @default("")
  bankAccountNumber String  @default("")
  lowStockThreshold Int     @default(5)
}

model DeliveryArea {
  id           String   @id @default(cuid())
  name         String
  translations String   @default("{}")
  fee          Decimal  @db.Decimal(10, 2)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([sortOrder, name])
}

model StoreContent {
  id           Int      @id @default(1)
  about        String   @default("")
  delivery     String   @default("")
  faq          Json     @default("[]")
  translations String   @default("{}")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model CustomerUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String
  city         String
  address      String
  orders       StoreOrder[]
  favorites    FavoriteProduct[]
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
}
